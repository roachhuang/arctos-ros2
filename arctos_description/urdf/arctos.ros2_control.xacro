<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- ARGUMENT TO TOGGLE FAKE HARDWARE -->
  <xacro:arg name="use_fake_hardware" default="false"/>

  <!-- Gripper limits for the single actuated jaw; the left jaw mimics in the URDF. -->
  <xacro:property name="gripper_limit_l" value="0.0"/>
  <xacro:property name="gripper_limit_u" value="0.015"/>

  <!-- JOINT MACRO -->
  <xacro:macro name="arctos_joint" params="name can_id vel acc gear_ratio limit_l limit_u" >
    <joint name="${name}">
      <param name="can_id">${can_id}</param>
      <param name="vel">${vel}</param>
      <param name="acc">${acc}</param>
      <param name="gear_ratio">${gear_ratio}</param>

      <command_interface name="position">
        <param name="min">${limit_l}</param>
        <param name="max">${limit_u}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- ROS2 CONTROL MACRO -->
  <xacro:macro name="arctos_ros2_control" params="use_fake_hardware:=false">

    <ros2_control name="arm" type="system">
      <hardware>
        <xacro:if value="$(arg use_fake_hardware)">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>

        <xacro:unless value="$(arg use_fake_hardware)">
          <plugin>arctos_hardware_interface/ArctosHardwareInterface</plugin>
          <class_type>arctos_hardware_interface::ArctosHardwareInterface</class_type>

          <param name="can_interface">can0</param>
          <!-- Single-jaw gripper parameters consumed by ArctosHardwareInterface. -->
          <param name="gripper_open_position">${gripper_limit_u}</param>
          <param name="gripper_close_position">${gripper_limit_l}</param>
          <param name="wrist_pitch_to_roll_gain">0.0</param>
          <param name="wrist_roll_to_pitch_gain">0.0</param>
          <param name="wrist_b_feedback_gain">0.0</param>
          <param name="wrist_c_feedback_gain">0.00</param>
          <!-- <param name="accel">20</param> -->
          <!-- <param name="vel">500</param> -->
        </xacro:unless>
      </hardware>

      <!-- JOINT DEFINITIONS -->
      <xacro:arctos_joint name="X_joint" can_id="1" vel="1" acc="1.5" gear_ratio="13.5" limit_l="${X_min_pos}" limit_u="${X_max_pos}"/>
      <xacro:arctos_joint name="Y_joint" can_id="2" vel="1" acc="3" gear_ratio="-150.0" limit_l="${Y_min_pos}" limit_u="${Y_max_pos}"/>
      <xacro:arctos_joint name="Z_joint" can_id="3" vel="1" acc="3" gear_ratio="150.0" limit_l="${Z_min_pos}" limit_u="${Z_max_pos}"/>
      <xacro:arctos_joint name="A_joint" can_id="4" vel="2" acc="8" gear_ratio="48.0" limit_l="${A_min_pos}" limit_u="${A_max_pos}"/>
      <xacro:arctos_joint name="B_joint" can_id="5" vel="2" acc="8" gear_ratio="67.82" limit_l="${B_min_pos}" limit_u="${B_max_pos}"/>
      <xacro:arctos_joint name="C_joint" can_id="6" vel="2" acc="8" gear_ratio="67.82" limit_l="${C_min_pos}" limit_u="${C_max_pos}"/>
      <!-- Only Right_jaw_joint is exported to ros2_control; Left_jaw_joint is a mimic joint. -->
      <xacro:arctos_joint name="Right_jaw_joint" can_id="7" vel="3.5" acc="15.0" gear_ratio="1"
      limit_l="${gripper_limit_l}" limit_u="${gripper_limit_u}"/>
    </ros2_control>

  </xacro:macro>
  
  <!-- INSTANTIATE THE MACRO -->
  <xacro:arctos_ros2_control use_fake_hardware="$(arg use_fake_hardware)"/>

</robot>
