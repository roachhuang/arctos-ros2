from launch import LaunchDescription
from launch_ros.actions import Node
import yaml
import os

def generate_launch_description():
    # 1. 初始化 MoveItConfigsBuilder
    moveit_config = (MoveItConfigsBuilder("arctos", package_name="arctos_moveit_config")
        .robot_description()          # 載入 URDF
        .robot_description_semantic() # 載入 SRDF
        .trajectory_execution()
        .planning_scene_monitor()
        .to_moveit_configs()
    )

    # 2. 強制讀取 Kinematics YAML 內容
    kinematics_yaml_path = os.path.join(
        get_package_share_directory("arctos_moveit_config"), "config", "kinematics.yaml"
    )
    with open(kinematics_yaml_path, 'r') as f:
        kinematics_config = {"robot_description_kinematics": yaml.safe_load(f)}

    # 3. 整合所有參數 (這一步最關鍵)
    # moveit_config.to_dict() 會輸出包含 robot_description 與 robot_description_semantic 的字典
    move_group_params = [
        moveit_config.to_dict(),
        kinematics_config,
        {"use_sim_time": False} # 如果是實體馬達，務必設為 False
    ]

    # 4. 手動啟動 move_group
    run_move_group_node = Node(
        package="moveit_ros_move_group",
        executable="move_group",
        output="screen",
        parameters=move_group_params,
    )

    # 5. 如果你也需要啟動 RViz，請確保它也收到了參數
    # ... rviz node 配置 ...

    return LaunchDescription([
        run_move_group_node,
        # rviz_node,
    ])